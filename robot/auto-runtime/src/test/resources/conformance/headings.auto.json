{
  "$schema": "https://libraries.horizon36596.org/zenith/schema/v1/auto.json",
  "formatVersion": 3,
  "name": "headings",
  "title": "Piecewise headings across a segment join and on a curve from the live pose",
  "alliance": "RED",
  "start": { "pose": { "ref": "a" } },
  "steps": [
    {
      "id": "turnAcrossTheJoin",
      "kind": "path",
      "segments": [
        { "kind": "line", "from": { "ref": "a" }, "to": { "ref": "b" } },
        { "kind": "line", "from": { "ref": "b" }, "to": { "ref": "c" } }
      ],
      "heading": {
        "mode": "piecewise",
        "ranges": [
          { "startT": 0, "endT": 0.25, "heading": { "mode": "constant", "headingRad": 0 } },
          { "startT": 0.25, "endT": 0.75, "heading": { "mode": "linear", "fromRad": 0, "toRad": 1.5708 } },
          { "startT": 0.75, "endT": 1, "heading": { "mode": "tangent" } }
        ]
      },
      "markers": [{ "at": { "t": 0.5 }, "command": { "name": "instant", "args": { "at": "join" } } }]
    },
    {
      "id": "curveFromHere",
      "kind": "path",
      "segments": [
        {
          "kind": "bezier",
          "from": "current",
          "control": [{ "xIn": 0, "yIn": -48 }],
          "to": { "ref": "d" }
        }
      ],
      "heading": {
        "mode": "piecewise",
        "ranges": [
          { "startT": 0, "endT": 0.4, "heading": { "mode": "tangentReversed" } },
          { "startT": 0.4, "endT": 1, "heading": { "mode": "facePoint", "xIn": 0, "yIn": 0 } }
        ]
      }
    },
    { "id": "after", "kind": "command", "name": "instant", "args": { "tag": "after" } }
  ]
}
