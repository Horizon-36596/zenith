"/** GENERATED by zenith from autos/first-auto.auto.json (sha deadbeef). Do not edit; edit the file. */

package org.firstinspires.ftc.teamcode.zenith;

import com.pedropathing.api.Paths;
import com.pedropathing.paths.Path;
import com.seattlesolvers.solverslib.command.Command;
import com.seattlesolvers.solverslib.command.ConditionalCommand;
import com.seattlesolvers.solverslib.command.InstantCommand;
import com.seattlesolvers.solverslib.command.SequentialCommandGroup;
import com.seattlesolvers.solverslib.command.WaitUntilCommand;
import com.seattlesolvers.solverslib.geometry.Pose2d;
import com.seattlesolvers.solverslib.geometry.Rotation2d;

import org.horizon36596.zenith.Args;
import org.horizon36596.zenith.solverslib.AutoFromFile;
import org.horizon36596.zenith.solverslib.DeferredPath;
import org.horizon36596.zenith.solverslib.NamedCommands;
import org.horizon36596.zenith.solverslib.Parallel;
import org.horizon36596.zenith.solverslib.PathMarkers;
import org.horizon36596.zenith.solverslib.Poses;
import org.horizon36596.zenith.solverslib.RobotTimeout;
import org.horizon36596.zenith.solverslib.WaitRobotTime;

/**
 * GENERATED by zenith from autos/first-auto.auto.json (sha deadbeef). Do not edit; edit the file.
 *
 * Reads as the plan: one private method per step, called in file order from buildRoutine().
 * Abstract, and never referenced by an {@code @Autonomous} OpMode; {@code zenith deploy} writes the
 * class that actually runs on the robot.
 */
public abstract class FirstAutoGenerated extends AutoFromFile {

    @Override
    protected Pose2d startPose() {
        return alliance(pose(-12.0, -63.0, 1.5708));
    }

    @Override
    protected Command buildRoutine() {
        return new SequentialCommandGroup(
            step("driveOut", stepDriveOut()),
            step("scorePreload", stepScorePreload()),
            step("park", stepPark())
        );
    }

    private static Pose2d pose(double xIn, double yIn, double headingRad) {
        return new Pose2d(xIn, yIn, new Rotation2d(headingRad));
    }

    private Command stepDriveOut() {
        Path seg0 = Paths.line(Poses.toPedro(alliance(pose(-12.0, -63.0, 1.5708)) /* ref: start */), Poses.toPedro(alliance(pose(-12.0, -36.0, 1.5708)) /* ref: scoreSouth */)).tangent();
        Path path = seg0;
        Command drive = followPath(path, defaultSpeedFraction());
        return drive;
    }

    private Command stepScorePreload() {
        return NamedCommands.build("score", Args.of("count", 4.0), this);
    }

    private Command stepPark() {
        // Starts from "current": built when the step starts, from where the robot is then.
        return DeferredPath.of("park", this, from -> stepParkFrom(from));
    }

    private Command stepParkFrom(Pose2d from) {
        Path seg0 = Paths.line(Poses.toPedro(from), Poses.toPedro(alliance(pose(-40.0, -36.0, 3.1416)) /* ref: park */)).tangent();
        Path path = seg0;
        Command drive = followPath(path, defaultSpeedFraction());
        return drive;
    }
}
"
`;

