{
  "name": "@horizon36596/zenith-schema",
  "version": "0.1.1",
  "description": "The Zenith file formats (link, robot, field, waypoints, auto) as zod schemas, TypeScript types and JSON Schema, with the migrations between format versions.",
  "keywords": [
    "ftc",
    "first-tech-challenge",
    "robotics",
    "autonomous",
    "zenith",
    "schema",
    "json-schema",
    "zod"
  ],
  "homepage": "https://libraries.horizon36596.org/zenith/",
  "bugs": {
    "url": "https://github.com/Horizon-36596/zenith/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Horizon-36596/zenith.git",
    "directory": "packages/schema"
  },
  "license": "MIT",
  "author": "Horizon (FTC 36596)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json/*.json": "./json/*.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.qa.test.*",
    "!dist/**/testSupport.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/testing",
    "!dist/**/testing.*",
    "json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen:json": "tsx scripts/gen-json-schema.mts",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.25.2"
  }
}
