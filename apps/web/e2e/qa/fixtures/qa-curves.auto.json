{
  "$schema": "https://libraries.horizon36596.org/zenith/schema/v1/auto.json",
  "formatVersion": 3,
  "name": "qa-curves",
  "title": "QA curves",
  "description": "A two-segment cubic with a corner node, a straight leg and a wait, for the QA canvas tests.",
  "robot": "autos/robot.json",
  "field": "autos/field/biobuzz.field.json",
  "alliance": "RED",
  "authors": ["Horizon (FTC 36596)"],
  "created": "2026-09-23",
  "start": { "pose": { "xIn": -36, "yIn": -36, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" } },
  "steps": [
    {
      "id": "curve",
      "kind": "path",
      "segments": [
        {
          "kind": "bezier",
          "from": "current",
          "control": [{ "xIn": -24, "yIn": -36 }, { "xIn": -12, "yIn": -24 }],
          "to": { "xIn": 0, "yIn": -12, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" }
        },
        {
          "kind": "bezier",
          "from": "current",
          "control": [{ "xIn": 12, "yIn": -12 }, { "xIn": 24, "yIn": 12 }],
          "to": { "xIn": 36, "yIn": 12, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" }
        }
      ],
      "heading": { "mode": "constant", "headingRad": 0 }
    },
    {
      "id": "hop",
      "kind": "path",
      "segments": [
        { "kind": "line", "from": "current", "to": { "xIn": 36, "yIn": 40, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" } }
      ],
      "heading": { "mode": "constant", "headingRad": 0 }
    },
    { "id": "pause", "kind": "wait", "seconds": 0.5 },
    {
      "id": "loose",
      "kind": "path",
      "segments": [
        {
          "kind": "line",
          "from": { "xIn": 36, "yIn": 40, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" },
          "to": { "xIn": 0, "yIn": 40, "headingRad": 0, "provenance": "SET BY HAND: QA fixture" }
        }
      ],
      "heading": { "mode": "constant", "headingRad": 0 }
    }
  ]
}
